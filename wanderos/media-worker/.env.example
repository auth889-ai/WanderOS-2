# WanderOS media-worker — copy to .env and fill in.
# Every name here MUST match app/config/settings.py exactly (pydantic-settings
# maps FIELD_NAME -> field_name; a mismatched name is silently ignored).

# ── Backblaze B2 (required) — storage + Object Lock provenance ─────────────
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_REGION=us-east-005
B2_BUCKET_MEDIA=wanderos-media
B2_BUCKET_PROVENANCE=wanderos-provenance
B2_BUCKET_INTERMEDIATE=wanderos-intermediate
B2_BUCKET_LOGS=wanderos-logs
OBJECT_LOCK_DAYS=30

# ── AWS (required) — Bedrock images + Claude reasoning + Polly narration ───
# Prerequisites (console only):
#   1. Bedrock -> Model access -> enable Anthropic models
#   2. IAM -> attach aws-iam-policy.json to the user
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_REGION=us-west-2
POLLY_VOICE=Joanna
AWS_STAGING_BUCKET=

# ── Claude critic + truth model ───────────────────────────────────────────
# Claude prefers Bedrock (runs on AWS credits). Set ANTHROPIC_API_KEY only to
# force the direct Anthropic API instead.
ANTHROPIC_API_KEY=
CRITIC_MODEL=claude-opus-5
CRITIC_THRESHOLD=0.85
MAX_SCENE_ATTEMPTS=3

# ── Provider failover chain (optional — each key adds a live fallback link) ─
# image: AWS Bedrock -> OpenAI DALL-E -> GMI | video: Sora -> GMI Kling
# audio: ElevenLabs -> Polly -> OpenAI TTS -> GMI
OPENAI_API_KEY=
GMI_API_KEY=
ELEVENLABS_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=

# ── App infra ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
PIPELINE_TIER=mock           # mock | dev | final
