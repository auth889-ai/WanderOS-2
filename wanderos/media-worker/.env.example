# ── Backblaze B2 (create at backblaze.com → App Keys) ─────────────
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_REGION=us-west-004
B2_BUCKET_MEDIA=wanderos-media
B2_BUCKET_PROVENANCE=wanderos-provenance
B2_BUCKET_INTERMEDIATE=wanderos-intermediate
B2_BUCKET_LOGS=wanderos-logs

# ── GMI Cloud (console.gmicloud.ai — submit hackathon credits form) ─
GMI_CLOUD_API_KEY=

# ── Optional premium providers (final renders only) ────────────────
ELEVENLABS_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
NVIDIA_API_KEY=

# ── App infra ──────────────────────────────────────────────────────
DATABASE_URL=postgresql://localhost:5432/wanderos_autopilot
REDIS_URL=redis://localhost:6379
PIPELINE_TIER=dev            # dev | final
APP_BASE_URL=http://localhost:3000
